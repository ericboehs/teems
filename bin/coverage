#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/inline'

gemfile do
  source 'https://rubygems.org'
  gem 'nokogiri'
end

# Path to the SimpleCov HTML report
coverage_file = File.join(Dir.pwd, 'coverage', 'index.html')

unless File.exist?(coverage_file)
  puts "No coverage report found at #{coverage_file}"
  puts 'Run tests first: bundle exec rake test'
  exit 1
end

# Parse the HTML file
doc = Nokogiri::HTML(File.read(coverage_file))

# Extract overall line coverage
line_percent = doc.css('.covered_percent span').first&.text&.strip
total_lines = doc.css('.t-line-summary b').first&.text&.strip
covered_lines = doc.css('.t-line-summary .green b').first&.text&.strip
missed_lines = doc.css('.t-line-summary .red b').first&.text&.strip

# Extract overall branch coverage (first t-branch-summary is the overall stats)
overall_branch_summary = doc.css('.t-branch-summary').first
if overall_branch_summary
  branch_percent = overall_branch_summary.css('span').last.text.strip.gsub(/[()]/, '')
  branch_summary_spans = overall_branch_summary.css('span b')
  overall_total_branches = branch_summary_spans[0]&.text&.strip
  overall_covered_branches = branch_summary_spans[1]&.text&.strip
  overall_missed_branches = branch_summary_spans[2]&.text&.strip
else
  branch_percent = nil
  overall_total_branches = nil
  overall_covered_branches = nil
  overall_missed_branches = nil
end

# Extract timestamp
timestamp = doc.css('.timestamp .timeago').first&.attr('title')

puts '## SimpleCov Coverage Report'
puts "Generated: #{timestamp}"
puts ''

puts "### Line Coverage: #{line_percent}"
puts "  #{covered_lines}/#{total_lines} lines covered"
puts "  #{missed_lines} lines missed"
puts ''

if branch_percent
  puts "### Branch Coverage: #{branch_percent}"
  puts "  #{overall_covered_branches}/#{overall_total_branches} branches covered"
  puts "  #{overall_missed_branches} branches missed"
  puts ''
end

def format_range(range)
  range.length == 1 ? range.first.to_s : "#{range.first}-#{range.last}"
end

def format_line_ranges(lines)
  return '' if lines.empty?

  ranges = lines.map(&:to_i).sort.slice_when { |a, b| b != a + 1 }.map { |c| format_range(c) }
  "L#{ranges.join(', L')}"
end

def file_fully_covered?(row)
  line_cov = row.css('.t-file__coverage').first&.text&.strip
  branch_cov = row.css('.t-file__branch-coverage').first&.text&.strip
  line_cov == '100.00 %' && (!branch_cov || branch_cov == '100.00 %')
end

def collect_files_with_issues(doc)
  files_shown = Set.new
  doc.css('tbody .t-file').reject { |row| file_fully_covered?(row) }.each_with_object([]) do |row, files|
    name = row.css('.t-file__name a').first&.text&.strip
    next if files_shown.include?(name)

    files_shown.add(name)
    files << row
  end
end

def classify_line(item)
  cls = item.attr('class')
  return :missed_branch if cls&.include?('missed-branch')
  return :missed_line if cls&.include?('missed')

  nil
end

def extract_line_details(file_section)
  missed_lines = []
  missed_branches = []
  file_section.css('li').each do |item|
    case classify_line(item)
    when :missed_branch then missed_branches << item.attr('data-linenumber')
    when :missed_line then missed_lines << item.attr('data-linenumber')
    end
  end
  [missed_lines, missed_branches]
end

def file_section_for(doc, file_link)
  return nil unless file_link

  section = doc.css("##{file_link.delete('#')}")
  section.any? ? section : nil
end

def parse_line_summary(section)
  text = section.css('.t-line-summary').text
  total = text.match(/(\d+)\s+relevant\s+lines/)&.captures&.first.to_i
  covered = text.match(/(\d+)\s+lines\s+covered/)&.captures&.first.to_i
  [total, covered]
end

def parse_branch_summary(section)
  spans = section.css('.t-branch-summary span b')
  return [0, 0] unless spans.any?

  [spans[0]&.text.to_i, spans[1]&.text.to_i]
end

def css_text(row, selector)
  row.css(selector).first&.text&.strip
end

def extract_row_fields(row)
  name_link = row.css('.t-file__name a').first
  { name: name_link&.text&.strip, link: name_link&.attr('href'),
    line_cov: css_text(row, '.t-file__coverage'),
    branch_cov: css_text(row, '.t-file__branch-coverage') }
end

def print_file_coverage(row, doc)
  fields = extract_row_fields(row)
  section = file_section_for(doc, fields[:link])

  branch_display = fields[:branch_cov] ? "Branch: #{fields[:branch_cov]}" : 'Branch: N/A'
  puts "  #{fields[:name]} (Line: #{fields[:line_cov]}, #{branch_display}):"
  print_details(section) if section
  puts ''
end

def print_details(section)
  total_lines, covered_lines = parse_line_summary(section)
  total_branches, covered_branches = parse_branch_summary(section)
  missed_lines, missed_branches = extract_line_details(section)

  line_info = "Lines: #{covered_lines}/#{total_lines}"
  line_info += " (missed: #{format_line_ranges(missed_lines)})" unless missed_lines.empty?
  puts "         #{line_info}"

  return unless total_branches.positive?

  branch_info = "Branches: #{covered_branches}/#{total_branches}"
  branch_info += " (missed: #{format_line_ranges(missed_branches)})" unless missed_branches.empty?
  puts "         #{branch_info}"
end

# Show file-by-file breakdown if there are missed lines or branches
if missed_lines.to_i.positive? || overall_missed_branches&.to_i&.positive?
  files_with_issues = collect_files_with_issues(doc)
  files_to_show = files_with_issues.take(50)

  puts '### Files with missing coverage:'
  puts ''
  if files_with_issues.length > 50
    puts "Showing top 50 of #{files_with_issues.length} files with missing coverage:"
    puts ''
  end

  files_to_show.each { |row| print_file_coverage(row, doc) }
end

# Write to GitHub Actions job summary if available
if ENV['GITHUB_STEP_SUMMARY']
  File.open(ENV['GITHUB_STEP_SUMMARY'], 'a') do |f|
    f.puts ''
    f.puts '## Test Coverage Report'
    f.puts ''
    f.puts "**Line Coverage:** #{line_percent} (#{covered_lines}/#{total_lines} lines)"
    f.puts ''

    if branch_percent
      f.puts "**Branch Coverage:** #{branch_percent} (#{overall_covered_branches}/#{overall_total_branches} branches)"
      f.puts ''
    end

    line_pct_value = line_percent.gsub('%', '').to_f
    branch_pct_value = branch_percent&.gsub('%', '')&.to_f

    if line_pct_value >= 95 && (!branch_pct_value || branch_pct_value >= 95)
      f.puts 'Coverage meets quality thresholds'
    elsif line_pct_value >= 80 && (!branch_pct_value || branch_pct_value >= 80)
      f.puts 'Coverage is acceptable but could be improved'
    else
      f.puts 'Coverage is below recommended thresholds'
    end
  end
end
